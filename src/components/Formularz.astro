---
// Formularz obsługiwany przez Netlify Forms (bez zewnętrznych skryptów).
// Każdy formularz musi mieć własną, unikalną nazwę (prop "nazwa").
// Etykiety pól są takie same jak na starej stronie.

// Wybór jednej opcji, pokazywany jako kafelki do kliknięcia (zamiast rozwijanej listy)
interface Lista {
  etykieta: string;
  nazwa: string;
  opcje: string[];
  wymagane?: boolean;
  /** 2 = kafelki obok siebie (dla krótkich opcji), domyślnie jeden pod drugim */
  kolumny?: 1 | 2;
}

interface Props {
  nazwa: string;
  /** Temat e-maila z powiadomieniem od Netlify */
  temat: string;
  listy?: Lista[];
  etykietaWiadomosci?: string;
  wiadomoscWymagana?: boolean;
  /** Komunikat po udanym wysłaniu */
  komunikatSukcesu?: string;
  class?: string;
}

const {
  nazwa,
  temat,
  listy = [],
  etykietaWiadomosci = 'Wiadomość',
  wiadomoscWymagana = true,
  komunikatSukcesu = 'Dziękuję, wiadomość została wysłana.',
  class: klasa,
} = Astro.props;

const id = (pole: string) => `${nazwa}-${pole}`;
import { strona } from '../data/strona';
---

<form
  class:list={['formularz', klasa]}
  name={nazwa}
  method="POST"
  action="/dziekuje"
  data-netlify="true"
  netlify-honeypot="bot-field"
  data-formularz
  data-sukces={komunikatSukcesu}
  data-telefon={strona.telefon}
>
  <input type="hidden" name="form-name" value={nazwa} />
  <input type="hidden" name="subject" value={temat} />

  <p class="formularz__pulapka" aria-hidden="true">
    <label>Nie wypełniaj tego pola: <input name="bot-field" tabindex="-1" autocomplete="off" /></label>
  </p>

  <p class="formularz__info">Pola oznaczone gwiazdką (*) są wymagane.</p>

  <div class="formularz__siatka">
    <div class="pole">
      <label for={id('imie')}>Imię i nazwisko</label>
      <input id={id('imie')} name="imie" type="text" autocomplete="name" />
    </div>

    <div class="pole">
      <label for={id('email')}>Email <span class="wymagane" aria-hidden="true">*</span></label>
      <input id={id('email')} name="email" type="email" autocomplete="email" required />
    </div>

    <div class="pole pole--cale">
      <label for={id('telefon')}>Numer telefonu</label>
      <input
        id={id('telefon')}
        name="telefon"
        type="tel"
        autocomplete="tel"
        inputmode="tel"
        pattern="[0-9 +\(\)\-]{7,20}"
        title="Wpisz numer telefonu, np. 602 677 707"
      />
    </div>

    {
      listy.map((lista) => (
        <fieldset class:list={['pole', 'pole--cale', 'wybor', lista.kolumny === 2 && 'wybor--dwie']}>
          <legend>
            {lista.etykieta}
            {lista.wymagane && (
              <span class="wymagane" aria-hidden="true">
                {' '}*
              </span>
            )}
          </legend>
          <div class="wybor__opcje">
            {lista.opcje.map((opcja, i) => (
              <label class="wybor__opcja">
                <input type="radio" id={id(`${lista.nazwa}-${i + 1}`)} name={lista.nazwa} value={opcja} required={lista.wymagane} />
                <span>{opcja}</span>
              </label>
            ))}
          </div>
        </fieldset>
      ))
    }

    <div class="pole pole--cale">
      <label for={id('wiadomosc')}>
        {etykietaWiadomosci}
        {wiadomoscWymagana && <span class="wymagane" aria-hidden="true"> *</span>}
      </label>
      <textarea id={id('wiadomosc')} name="wiadomosc" rows="5" required={wiadomoscWymagana}></textarea>
    </div>

    <div class="pole pole--cale pole--zgoda">
      <input id={id('zgoda')} name="zgoda" type="checkbox" value="tak" required />
      <label for={id('zgoda')}>
        Wyrażam zgodę na przetwarzanie moich danych osobowych podanych w formularzu w celu odpowiedzi na wiadomość.
        Administratorem danych jest Izabela Knul. Więcej informacji w <a href="/polityka-prywatnosci">Polityce prywatności</a>.
        <span class="wymagane" aria-hidden="true">*</span>
      </label>
    </div>
  </div>

  <div class="formularz__wyslij">
    <button class="przycisk" type="submit">Wyślij</button>
  </div>

  <p class="formularz__komunikat" role="status" aria-live="polite" tabindex="-1" hidden></p>
</form>

<script>
  const KOMUNIKATY = {
    popraw: 'Popraw zaznaczone pola: ',
    blad: 'Nie udało się wysłać wiadomości. Spróbuj ponownie albo zadzwoń: ',
  };

  // „Pole” to jeden element .pole: zwykłe pole tekstowe, zgoda albo cała grupa kafelków wyboru.
  type Kontrolka = HTMLInputElement | HTMLTextAreaElement;

  const kontrolki = (pole: HTMLElement) => [...pole.querySelectorAll<Kontrolka>('input, textarea')];
  const poprawne = (pole: HTMLElement) => kontrolki(pole).every((k) => k.checkValidity());

  const pokaz = (formularz: HTMLFormElement, tekst: string, rodzaj: 'sukces' | 'blad', ustawFokus = true) => {
    const komunikat = formularz.querySelector<HTMLElement>('.formularz__komunikat');
    if (!komunikat) return;
    komunikat.textContent = tekst;
    komunikat.dataset.rodzaj = rodzaj;
    komunikat.hidden = false;
    if (ustawFokus) komunikat.focus();
  };

  // Treść błędu dla konkretnego pola
  const opisBledu = (pole: HTMLElement) => {
    const [k] = kontrolki(pole);
    if (!k) return 'Sprawdź to pole.';
    if (k.type === 'radio') return 'Wybierz jedną z opcji.';
    if (k.type === 'checkbox') return 'Zaznacz zgodę, aby wysłać formularz.';
    const v = k.validity;
    if (v.valueMissing) return 'To pole jest wymagane.';
    if (v.typeMismatch && k.type === 'email') return 'Wpisz poprawny adres e-mail, np. imie@przyklad.pl.';
    if (v.patternMismatch && k.type === 'tel') return 'Wpisz numer telefonu, np. 602 677 707.';
    return 'Sprawdź to pole.';
  };

  const nazwaPola = (pole: HTMLElement) => {
    const [k] = kontrolki(pole);
    if (k?.type === 'checkbox') return 'Zgoda';
    const etykieta = pole.querySelector('legend')?.textContent ?? k?.labels?.[0]?.textContent ?? k?.name ?? '';
    return etykieta.replace('*', '').trim();
  };

  const usunBlad = (pole: HTMLElement) => {
    kontrolki(pole).forEach((k) => {
      k.removeAttribute('aria-invalid');
      k.removeAttribute('aria-describedby');
    });
    pole.querySelector('.pole__blad')?.remove();
  };

  const pokazBlad = (pole: HTMLElement) => {
    usunBlad(pole);
    const lista = kontrolki(pole);
    const blad = document.createElement('p');
    blad.className = 'pole__blad';
    blad.id = `${lista[0]?.id}-blad`;
    blad.textContent = opisBledu(pole);
    pole.append(blad);
    lista.forEach((k) => {
      k.setAttribute('aria-invalid', 'true');
      k.setAttribute('aria-describedby', blad.id);
    });
  };

  document.querySelectorAll<HTMLFormElement>('form[data-formularz]').forEach((formularz) => {
    formularz.noValidate = true;
    const pola = [...formularz.querySelectorAll<HTMLElement>('.pole')];

    // Błąd znika, gdy pole zostanie poprawione
    pola.forEach((pole) => {
      const sprawdz = () => {
        if (pole.querySelector('.pole__blad') && poprawne(pole)) usunBlad(pole);
      };
      pole.addEventListener('input', sprawdz);
      pole.addEventListener('change', sprawdz);
    });

    formularz.addEventListener('submit', async (zdarzenie) => {
      zdarzenie.preventDefault();

      const bledne = pola.filter((pole) => !poprawne(pole));
      pola.forEach((pole) => (bledne.includes(pole) ? pokazBlad(pole) : usunBlad(pole)));
      if (bledne.length) {
        pokaz(formularz, KOMUNIKATY.popraw + bledne.map(nazwaPola).join(', ') + '.', 'blad', false);
        kontrolki(bledne[0])[0]?.focus();
        return;
      }

      const przycisk = formularz.querySelector<HTMLButtonElement>('button[type="submit"]');
      if (przycisk) przycisk.disabled = true;

      try {
        const dane = new URLSearchParams(new FormData(formularz) as unknown as Record<string, string>);
        const odpowiedz = await fetch('/', {
          method: 'POST',
          headers: { 'Content-Type': 'application/x-www-form-urlencoded' },
          body: dane.toString(),
        });
        if (!odpowiedz.ok) throw new Error(String(odpowiedz.status));
        formularz.reset();
        pokaz(formularz, formularz.dataset.sukces ?? '', 'sukces');
      } catch {
        pokaz(formularz, `${KOMUNIKATY.blad}${formularz.dataset.telefon}.`, 'blad');
      } finally {
        if (przycisk) przycisk.disabled = false;
      }
    });
  });

  // Przyciski „Zapisz się na szkolenie” mogą od razu zaznaczyć szkolenie w formularzu.
  document.querySelectorAll<HTMLAnchorElement>('a[data-wybierz]').forEach((link) => {
    link.addEventListener('click', () => {
      const cel = document.querySelector(link.hash);
      const opcje = [...(cel?.querySelectorAll<HTMLInputElement>('input[type="radio"]') ?? [])];
      const opcja = opcje.find((o) => o.value === link.dataset.wybierz);
      if (!opcja) return;
      opcja.checked = true;
      opcja.dispatchEvent(new Event('change', { bubbles: true }));
    });
  });
</script>

<style>
  .formularz {
    width: 100%;
  }

  .formularz__pulapka {
    position: absolute;
    left: -9999px;
    width: 1px;
    height: 1px;
    overflow: hidden;
  }

  .formularz__info {
    margin-bottom: 1.25rem;
    font-size: 0.9375rem;
  }

  .formularz__siatka {
    display: grid;
    gap: 1.25rem;
  }

  @media (min-width: 40rem) {
    .formularz__siatka {
      grid-template-columns: 1fr 1fr;
    }

    .pole--cale {
      grid-column: 1 / -1;
    }
  }

  .pole label {
    display: block;
    margin-bottom: 0.4rem;
    font-weight: 700;
  }

  .wymagane {
    color: var(--braz);
  }

  .pole input:not([type='checkbox']):not([type='radio']),
  .pole textarea {
    width: 100%;
    min-height: 3rem;
    padding: 0.75rem 0.9rem;
    border: 1.5px solid var(--braz);
    border-radius: 10px;
    background: var(--bialy);
    color: var(--ciemny);
    font: inherit;
  }

  .pole textarea {
    resize: vertical;
  }

  .pole input:focus-visible,
  .pole textarea:focus-visible {
    outline: 3px solid var(--braz);
    outline-offset: 2px;
    border-color: var(--ciemny);
  }

  /* ---------- Wybór jednej opcji: kafelki zamiast rozwijanej listy ---------- */
  .wybor {
    min-width: 0;
    margin: 0;
    padding: 0;
    border: 0;
  }

  .wybor legend {
    margin-bottom: 0.6rem;
    padding: 0;
    font-weight: 700;
  }

  .wybor__opcje {
    display: grid;
    gap: 0.6rem;
  }

  @media (min-width: 30rem) {
    .wybor--dwie .wybor__opcje {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
  }

  .pole .wybor__opcja {
    display: flex;
    align-items: center;
    gap: 0.85rem;
    min-height: 3.25rem;
    margin: 0;
    padding: 0.75rem 1rem;
    border: 1.5px solid var(--szarosc);
    border-radius: 12px;
    background: var(--bialy);
    font-weight: 500;
    line-height: 1.35;
    cursor: pointer;
    transition:
      border-color 0.2s ease,
      background-color 0.2s ease,
      box-shadow 0.2s ease;
  }

  .pole .wybor__opcja:hover {
    border-color: var(--braz);
    background: var(--piasek);
  }

  .pole .wybor__opcja:has(input:checked) {
    border-color: var(--braz);
    background: var(--zloto-jasne);
    box-shadow: inset 0 0 0 1px var(--braz);
  }

  .pole .wybor__opcja:has(input:focus-visible) {
    outline: 3px solid var(--braz);
    outline-offset: 2px;
  }

  .pole .wybor__opcja:has(input[aria-invalid='true']) {
    border-color: var(--blad);
  }

  /* Okrągły znacznik wyboru w kolorach strony */
  .wybor__opcja input {
    appearance: none;
    display: grid;
    place-content: center;
    flex: none;
    width: 1.35rem;
    height: 1.35rem;
    margin: 0;
    border: 2px solid var(--braz);
    border-radius: 50%;
    background: var(--bialy);
    cursor: pointer;
  }

  .wybor__opcja input::before {
    content: '';
    width: 0.65rem;
    height: 0.65rem;
    border-radius: 50%;
    background: var(--braz);
    transform: scale(0);
    transition: transform 0.15s ease;
  }

  .wybor__opcja input:checked::before {
    transform: scale(1);
  }

  /* Gdy przeglądarka umie podświetlić cały kafelek, obwódka jest tylko na kafelku */
  @supports selector(:has(*)) {
    .pole .wybor__opcja input:focus-visible {
      outline: none;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .pole .wybor__opcja,
    .wybor__opcja input::before {
      transition: none;
    }
  }

  /* Tryb wysokiego kontrastu (Windows): zwykłe przyciski wyboru systemu */
  @media (forced-colors: active) {
    .wybor__opcja input {
      appearance: auto;
    }

    .wybor__opcja input::before {
      display: none;
    }
  }

  .pole [aria-invalid='true'] {
    border-color: var(--blad);
    border-width: 2px;
  }

  .pole :global(.pole__blad) {
    margin: 0.4rem 0 0;
    color: var(--blad);
    font-size: 0.9375rem;
    font-weight: 700;
  }

  .pole--zgoda :global(.pole__blad) {
    grid-column: 1 / -1;
  }

  .pole--zgoda {
    display: grid;
    grid-template-columns: auto 1fr;
    gap: 0.75rem;
    align-items: start;
  }

  .pole--zgoda input {
    width: 1.5rem;
    height: 1.5rem;
    margin: 0.15rem 0 0;
    accent-color: var(--braz);
  }

  .pole--zgoda label {
    margin: 0;
    font-weight: 400;
    font-size: 0.9375rem;
    line-height: 1.5;
  }

  .formularz__wyslij {
    margin-top: 1.75rem;
  }

  .formularz__wyslij .przycisk {
    min-width: 10rem;
  }

  .formularz__wyslij .przycisk:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .formularz__komunikat {
    margin-top: 1.25rem;
    padding: 1rem 1.25rem;
    border-radius: 10px;
    border-left: 5px solid currentColor;
    font-weight: 700;
  }

  .formularz__komunikat[data-rodzaj='sukces'] {
    background: var(--sukces-tlo);
    color: var(--sukces);
  }

  .formularz__komunikat[data-rodzaj='blad'] {
    background: var(--blad-tlo);
    color: var(--blad);
  }
</style>
